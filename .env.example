# Endereço e chave pública (anon ou publishable) do seu projeto Supabase.
# Painel do Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional. Só para ver o app sem Supabase (dados ficam em cookies do navegador).
# Ignorado quando as duas variáveis acima existem e em produção na Vercel.
# GBF_MODO_DEMO=1
# Opcional. Endereço público do site (ex.: https://gbfinancas.vercel.app), usado no link de
# confirmação de e-mail quando a requisição não informa a origem. Se vazio, cai em http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=
# Opcional. As cotações da tela Mercado vêm da brapi.dev e funcionam
# sem chave. Com uma chave (brapi.dev → Dashboard), valem os limites do seu plano.
# BRAPI_TOKEN=
# Opcional. Leitura com IA (texto, voz, foto de nota, PDF) e categoria automática.
# ANTHROPIC_API_KEY=
# GBF_IA_MODELO=claude-opus-5-5
# Só no servidor. WhatsApp e lembretes rodam sem a sessão da pessoa e precisam desta chave.
# SUPABASE_SERVICE_ROLE_KEY=
# Lembretes por e-mail (resend.com) e rota agendada.
# RESEND_API_KEY=
# GBF_EMAIL_REMETENTE="GBFinanças <avisos@seudominio.com>"
# CRON_SECRET=
# WhatsApp Cloud API (developers.facebook.com).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_NUMERO=5511999999999
# WHATSAPP_TEMPLATE_LEMBRETE=
# Conexão com bancos (Open Finance) pela Pluggy (pluggy.ai).
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=
# PLUGGY_WEBHOOK_SEGREDO=
# PLUGGY_SANDBOX=1
# Quando a assinatura começar a ser cobrada.
# GBF_COBRANCA_ATIVA=1
