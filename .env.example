# Endereço e chave pública (anon ou publishable) do seu projeto Supabase.
# Painel do Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional. Só para ver o app sem Supabase (dados ficam em cookies do navegador).
# Ignorado quando as duas variáveis acima existem e em produção na Vercel.
# GBF_MODO_DEMO=1
# Opcional. Endereço público do site (ex.: https://gbfinancas.vercel.app), usado no link de
# confirmação de e-mail quando a requisição não informa a origem. Se vazio, cai em http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=
# Opcional. As cotações da tela Mercado e da faixa do topo vêm da brapi.dev e funcionam
# sem chave. Com uma chave (brapi.dev → Dashboard), valem os limites do seu plano.
# BRAPI_TOKEN=
